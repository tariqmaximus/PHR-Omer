<patient-info class="flex-shrink-0"></patient-info>

<div class="bg-white m-8 d-flex flex-column flex-grow-1 overflow-height position-relative">
<div class="border border-bottom-0 LoginLogHeader">


    <div class="section-title pl-3">
      <span class="text-app-blue font-weight-500">Login Log</span>
    </div>
    <div class="col-auto" style="max-height: 33px !important;">
          
      <form [formGroup]="filterForm">
          <div class="d-flex flex-grow-3 col-12 pr-0">  
            <div class="input-group pr-0 pl-0  col-2 EncountersInput">  
              <div class="input-group-prepend">
                <label for="dateFrom" class="input-group-text">From</label>
              </div>
              <input id="dateFrom" formControlName="dateFrom" class="form-control mr-0 date-control "
                placeholder="mm/dd/yyyy" name="dateFrom" ngbDatepicker #dateFrom="ngbDatepicker">
              <span class="input-group-btn">
                <button class="btn date-control-btn" (click)="dateFrom.toggle()" type="button" focusable="false"
                  tabindex="-1">
                </button>
              </span>
            </div>
            <div class="input-group pr-0 col-2 EncountersInput loginLogTime">
              <div class="input-group-prepend">
                <span class="input-group-text ngb-timepicker-input-group-text"><i class="far fa-clock"></i></span>
              </div>
              <ngb-timepicker id="tpFromTime" class="form-control form-control-ngb-timepicker required"
                formControlName="tpFromTime" meridian="ON">
              </ngb-timepicker>
            </div>
  
            <div class="input-group pr-0 col-2 EncountersInput">
              <div class="input-group-prepend">
                <label for="dateTo" class="input-group-text">To</label>
              </div>
  
              <input id="dateTo" formControlName="dateTo" class="form-control mr-0 date-control "
                placeholder="mm/dd/yyyy" name="dateTo" ngbDatepicker #dateTo="ngbDatepicker">
  
              <span class="input-group-btn">
                <button class="btn date-control-btn" (click)="dateTo.toggle()" type="button" focusable="false"
                  tabindex="-1">
                </button>
              </span>
  
            </div>
            <div class="input-group pr-0 col-2 EncountersInput loginLogTime">
              <div class="input-group-prepend">
                <span class="input-group-text ngb-timepicker-input-group-text"><i class="far fa-clock"></i></span>
              </div>
              <ngb-timepicker id="tpToTime" class="form-control form-control-ngb-timepicker required"
                formControlName="tpToTime" type="time" meridian="ON">
              </ngb-timepicker>
            </div>
            <div class="input-group pr-0 col-2 EncountersInput">
              <!-- <div class="input-group-prepend">
                <span class="input-group-text">Is Login Fail</span>
              </div> -->
  

              <div class="custom-control custom-checkbox green-checkbox pl-1">
                <input type="checkbox" class="custom-control-input" id="chkisLoginFail"
                  formControlName="chkisLoginFail">
                <label class="custom-control-label" for="chkisLoginFail">Is Fail Login</label>
              </div>  
            </div>

            <div class="input-group pr-0 col-2 EncountersInput">
            <button type="button" class="btn btn-primary w-100"
            (click)="onSearchClick(filterForm.value)">Search</button>
          </div>
          </div>
        </form>
    </div>

  </div>
    <div class="border flex-grow-1 overflow-auto max-height-100">
      <table class="table light-blue-striped-border">
        <thead>
          <tr>
            
            <th scope="col" sortable="system_ip" type="alpha" (sort)="onSort($event)">System Ip</th>
            <th scope="col" sortable="user_id" type="alpha" (sort)="onSort($event)">User Name</th>
            <th scope="col" sortable="logintime" type="datetime" formate="MM/DD/YYYY hh:mm A" (sort)="onSort($event)">Login Time</th>
            <th scope="col" sortable="logouttime" type="datetime" formate="MM/DD/YYYY hh:mm A" (sort)="onSort($event)">Logout Time</th>
            <th scope="col" sortable="status" type="alpha" (sort)="onSort($event)">Status</th>
          </tr>
        </thead>    
        <tbody>
            <tr *ngFor="let login of lstLoginLog" (click)="selectClickedRow(login)" 
            [ngClass]="{'active' : (login.logid === selectedRowID)}">
              <td>{{login.system_ip}}</td>
              <td>{{login.user_id}}</td>
              <td>{{login.logintime}}</td>
              <td>{{login.logouttime}}</td>
              <td>{{login.status}}</td>
            </tr>
        </tbody>
      </table>
    </div>


    <div class="div-ui-blocker" id="uiBlocker" *ngIf="isLoading">
      <div class="div-ui-blocker-message-box ">
          <i class="fas fa-spinner fa-spin mr-1"></i>Loading
      </div>
  </div>

</div>
