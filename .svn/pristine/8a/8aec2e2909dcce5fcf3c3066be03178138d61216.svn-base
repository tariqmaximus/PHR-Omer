.div-ui-blocker{
    font-size: 1em;
    padding-left: 8px;
    padding-right: 8px;
    display: flex !important;
    height: 100%; 
    width: 100%; 
    position: absolute;
    left: 50%;
    top: 50%;   
    align-self: center !important;
    align-items: center !important;    
    background-color: #0073aa69  !important;
    transform: translateX(-50%) translateY(-50%);   
    justify-content: center!important;
    z-index: 100;
}

.div-ui-blocker-message-box {
    font-size: 1em;
    padding: 10px;
    display: flex !important;
    height: 50px;  
    border-radius: 3px;    
    align-self: center !important;
    align-items: center !important;
    border: 1px solid #114671 !important;
    background-color: #206196 !important;    
    color: white;    
}

.bg-disabled {
    background-color: #e9ecef !important;
}