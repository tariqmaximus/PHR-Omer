.btn {
    cursor: pointer;
    box-shadow: none !important;
    border-radius: 3px;
}

button:focus, button:active, .btn:focus, .btn:active {
    outline: none;
    box-shadow: none;
}

.btn-danger:not([disabled]):not(.disabled).active,
.btn-danger:not([disabled]):not(.disabled):active,
.show>.btn-danger.dropdown-toggle {
    box-shadow: none;
}

.btn-tiny {
    font-size: 10px;
    padding: 0px 4px;
    border-radius: 2px;
}

.row.zero  {
    margin-right: 0;
    margin-left: 0;
}
/* .row.zero > .col,
.row.zero > [class*=col-] {
    padding-right:0;
    padding-left: 0;
} */

.row.p2  {
    margin-right: -2px;
    margin-left: -2px;
}
.row.p2 > .col,
.row.p2 > [class*=col-] {
    padding-right: 2px;
    padding-left: 2px;
}

a:hover {
    text-decoration: none;
}


@-webkit-keyframes loader-spin {
    0% {
        -webkit-transform: rotate(0deg);
        transform: rotate(0deg);
    }
    100% {
        -webkit-transform: rotate(359deg);
        transform: rotate(359deg);
    }
}
@keyframes loader-spin {
    0% {
        -webkit-transform: rotate(0deg);
        transform: rotate(0deg);
    }
    100% {
        -webkit-transform: rotate(359deg);
        transform: rotate(359deg);
    }
}

.div-loader::after {
    /*font: normal normal normal 20px/1 FontAwesome;*/
    font-family: 'Font Awesome 5 Free';
    content: "\f110";

     /* >> Weight of the font (mandatory)
               - 400 for Regular and Brands symbols;
               - 900 for Solid symbols. */
    font-weight: 900;

    position: absolute;
    left: 50%;
    top: calc(50% - 35px);
    transform: translateX(-50%) translateY(-50%);
    -webkit-animation: loader-spin 1s infinite steps(8);
    animation: loader-spin 1s infinite steps(8);
}
.div-loader::before {
    font-family: Roboto;
    font-size: 13px;
    font-weight: 400;
    content: "loading";
    text-align: center;
    position: absolute;
    left: 50%;
    top: calc(50% );
    transform: translateX(-30%) translateY(-50%);
}



