  <div class="modal-content custom ">
    <div class="modal-header custom" >
        <img alt="Maximus Patient Health Portal" class="logo" src="./assets/images/logo-small.png">
      <h1 class="modal-title fz-14">{{header}}</h1>
      <button type="button" class="close" aria-label="Close" (click)="activeModal.dismiss('Cross click')">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
    <div class="modal-body custom dashboard" style="height: 80vh !important; overflow-y: auto;" >  
      <button  class="btn btn-primary btn-sm" style="width: 60px;right: 5px; top: 5px; position: absolute; z-index: 1;" type="button" (click)="printDiv(printpnl.innerHTML)">Print</button>
      <div class="dashboard-content" [innerHTML]="print_html" #printpnl>
    <div>
  </div>