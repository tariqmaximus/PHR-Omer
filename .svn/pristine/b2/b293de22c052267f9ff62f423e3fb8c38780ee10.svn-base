.form-row.form-dashboard .form-group > .input-group > .input-group-btn > .btn {
    border-radius: 0 3px 3px 0;
}
*/
.form-row.form-dashboard .form-group > .input-group > .input-group-addon {
    padding: 2px 6px;
    font-size: 14px;
}


.form-row.form-dashboard .form-group > .input-group > .input-group-addon:not(:last-child) {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right: none;
}

.form-row.form-dashboard .form-group > .input-group > .input-group-addon:not(:first-child) {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}

.form-row.form-dashboard .form-group > .input-group > .input-group-addon:not(:first-child):not(:last-child) {
    border-radius: 0;
}

.form-row.form-dashboard .form-group >.form-button{
    margin-top: 20px;
    margin-bottom: 0;
}

.form-row.form-dashboard .form-group >.form-check {
    margin-top: 20px;
    margin-bottom: 0;
}


.form-row.form-dashboard .form-check,
.form-row.form-dashboard .form-radio {
    padding-top: 24px;
    margin-bottom: 0;
}

.form-row.form-dashboard .form-check > .custom-checkbox,
.form-row.form-dashboard .form-radio > .custom-radio {
    font-size: 12px;
    margin-right: 0;
    margin-bottom: 0;
    padding-left: 1.3rem;
}

.form-row.form-dashboard .form-check>.custom-checkbox + .custom-checkbox,
.form-row.form-dashboard .form-radio>.custom-radio + .custom-radio {
    margin-left: 10px;
}

.form-row.form-dashboard .form-check>.custom-checkbox .custom-control-indicator,
.form-row.form-dashboard .form-radio>.custom-radio .custom-control-indicator {
    top: .15rem;
}

.form-row.form-dashboard .form-check>.custom-checkbox .custom-control-input:focus~.custom-control-indicator,
.form-row.form-dashboard .form-radio>.custom-radio .custom-control-input:focus~.custom-control-indicator {
    box-shadow: none;
}

.form-row.form-dashboard .invalid-feedback {
    margin-top: 0;
    font-size: 11px;
    font-weight: 400;
}

.form-row.form-dashboard .alert {
    padding: 0.25rem 0.5rem;
    font-size: 12px;
}
.form-row.form-dashboard .alert ul {
    margin-bottom: 0;
    padding-left: 1rem;
}

.form-row p {
    font-size: 12px;   
    font-weight: 400;
}

.input-icon {
    position: relative;
}

.input-icon .icon {
    position: absolute;
    top: 50%;
    right: 8px;
    font-size: 14px;
    line-height: 12px;
    transform: translateY(-50%);
    color: #2e7fc1;
}

.dashboard-sub-nav.filters .input-icon .icon {
    right: 12px;
}

.search-result-inline-table {
    position: absolute;
    left: 0;
    top: 100%;
    background-color: #2ab2e3;
    width: 450px;
    height: 250px;
    z-index: 100;
    -webkit-box-shadow: 0 5px 10px 0 rgba(0,0,0,0.075);
    box-shadow: 0 5px 10px 0 rgba(0,0,0,0.075);
    border-radius: 1px;
    margin-top: 1px;
    border: 1px solid #2ab2e3;
    display: flex;
    flex-flow: column;
}

.search-result-inline-table .close {   
    line-height: 0.8;
    margin-right: 4px;
}

.inline-search {
    position: absolute;
    left: 0;
    top: 100%;
    background-color: #2ab2e3;
    width: 450px;    
    z-index: 100;
    -webkit-box-shadow: 0 5px 10px 0 rgba(0,0,0,0.075);
    box-shadow: 0 5px 10px 0 rgba(0,0,0,0.075);
    border-radius: 1px;
    margin-top: 1px;
    border: 1px solid #2ab2e3;
    display: flex;
    flex-flow: column;
}
.inline-search .close {   
    line-height: 0.8;
    margin-right: 4px;
}
.inline-search .close span{   
    font-size: inherit !important;
    color: inherit !important;
}


.inline-search .inline-search-header {   
  display: flex;
  color: #09385f;
}
.inline-search .inline-search-header p {   
    margin: 0;
    padding: 2px 0px 0px 8px;
}
.inline-search .inline-search-header .title {   
    font-size: 12px;
    line-height: normal;
    font-weight: 500;
    margin-top: 3px;
    margin-left: 8px;
    margin-bottom: 0px;
    flex-grow: 1;
    color: #252e47;
    border: none;
}

.inline-search .inline-search-header .close {   
    line-height: 0.8;
    margin-right: 4px;
}

.inline-search .body {   
    height: 229px;
    overflow: auto;
    position: relative;
    background: #ffffff;
    flex-grow: 1;
    -webkit-box-flex: 1;
    display: flex;
    flex-flow: column;
}



.search-result-inline-table .table.light-blue-striped thead tr,
.search-result-inline-table .table.light-blue-striped-border thead tr {
    background-color: rgba(213, 229, 243, .6);
    border:none;
}

.search-result-inline-table .table.light-blue-striped tbody tr,
.search-result-inline-table .table.light-blue-striped-border tbody tr {
    border: none;
}

.search-result-inline-table .table.light-blue-striped tbody tr:nth-of-type(odd),
.search-result-inline-table .table.light-blue-striped-border tbody tr:nth-of-type(odd) {
    background-color: rgba(243, 247, 251, .7);
}

.search-result-inline-table .table.light-blue-striped tbody tr.active,
.search-result-inline-table .table.light-blue-striped-border tbody tr.active {
    color: #101010;
    background-color: #c1d9ed;
}

.nav.inner-page-nav {
    height: 35px;
}

.nav.inner-page-nav .nav-link {
    display: flex;
    font-size: 13px;
    color: #454545;
    padding: 0;
    align-items: center;
    padding: 0 12px;
    border-left: 1px solid #e4e6ec;
    transition: 0.5s;
}

.nav.inner-page-nav .nav-link:first-child {
    border-left: none;
}

.nav.inner-page-nav .nav-link:last-child {
    border-right: 1px solid #e4e6ec;
}

.nav.inner-page-nav .nav-link:hover {
    color: #2e7fc1;
}

.nav.inner-page-nav .nav-link.active {
    color: #ffffff;
    background-color: #2ebd6b;
    border-left: none;
    border-right: none;
}

.nav.inner-page-nav .nav-link.active + .nav-link {
    border-left: none;
}

.nav.inner-page-nav .nav-link:first-child.active {
    border-radius: 1px 0 0 1px;
}

.form-row.form-dashboard h4, .form-edit-sub-heading {
    font-weight: 500;
    font-size: 14px;
    color: #2e7fc1;
    border-bottom: 1px solid #d5e6f3;
    padding-bottom: 3px;
    margin-top: 24px;
}
.form-row.form-dashboard h6, .form-edit-sub-heading-small {
    font-weight: 500;
    font-size: 12px;
    color: #2e7fc1;
    border-bottom: 1px solid #d5e6f3;
    padding-bottom: 3px;
    margin-top: 24px;
}
.form-edit-sub-heading-small a {
    font-size: 12px;
    color: #2972ad;
}


.link-btn {
    color: #007bff;
    text-decoration: none;
    background: 0;
    border: none;
    padding: 0;
    cursor: pointer;
}

.link-btn:hover {
    color: #0056b3;
}

.dashboard-title .title-btn-link {
    font-size: 18px;
    width: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.dashboard-title .title-btn-link > button {
    color: #2972ad;
    text-decoration: none;
    background: 0;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: 0.5s;
}
.dashboard-title .title-btn-link > button:hover {
    color: #00aaef;
}

.dropdown-menu.dashboard-dropdown {
    border-color: #edeff5;
    left: auto;
    right: 0;
    border-radius: 0 0 1px 1px;
    padding: 0;
    width: 240px;
}

.dropdown-menu.dashboard-dropdown form {
    padding: 0 10px 10px;
}

.dropdown-menu.dashboard-dropdown .dropdown-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    line-height: 14px;
    padding: 6px 5px 6px 10px;
    background: -moz-linear-gradient(top, rgba(164, 201, 234, .4) 0%, rgb(164, 201, 234) 100%);
    background: -webkit-linear-gradient(top, rgba(164, 201, 234, .4) 0%,rgb(164, 201, 234) 100%);
    background: linear-gradient(to bottom, rgba(164, 201, 234, .4) 0%,rgb(164, 201, 234) 100%);
}

.dropdown-menu.dashboard-dropdown .dropdown-title .close-btn {
    background: none;
    border: none;
    padding: 0;
    color: #dc3545;
    cursor: pointer;
    background-color: rgba(255, 255, 255, .6);
    border-radius: 50%;
}

.dropdown-menu.dashboard-dropdown .dropdown-title .close-btn:hover {
    color: #bd2130;
}

.dashboard-sub-nav.filters {
    background-color: #c1d9ed;
    height: 30px;
}

.dashboard-sub-nav.filters > form {
    flex-grow: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.dashboard-sub-nav.filters h4 {
    font-size: 13px;
    color: #252525;
    font-weight: 400;
    margin: 0 6px 0 0;
    flex-shrink: 0;
    line-height: normal;
}

.dashboard-sub-nav.filters span {
    font-size: 13px;
    color: #252525;
}

.dashboard-sub-nav.filters .form-control {
    font-size: 13px;
    width: auto;
    height: 22px !important;
    line-height: normal;
    padding: 0 8px;
    margin: 0 6px 0 0;
    border: none;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 2px;
    transition: 0.5s;
}

.dashboard-sub-nav.filters .form-control:focus {
    background: rgba(255, 255, 255, 1);
    box-shadow: none;
}

.dashboard-sub-nav.filters .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    background-color: #2ebd6b;
    height: 22px;
    border: none;
    font-size: 13px;
    line-height: normal;
    padding: 0 8px;
    margin: 0;
    border-radius: 2px;
    flex-shrink: 0;
}

.dashboard-container .dashboard.patient-summary-graph {
    height: 220px;
}

.dashboard-container .dashboard.patient-summary-info {
    height: 192px;
}

.dashboard-container .dashboard.patient-summary {
    height: 400px;
}

.dashboard-container .dashboard > .patient-all-comp{
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}


.card.dashboard-card {
    border: none;
}

.card.dashboard-card + .card.dashboard-card {
    margin-top: 1px;
}

.card.dashboard-card .card-header {
    border: none;
    background: none;
    padding: 0;
    border-radius: 1px;
    display: flex;
}

.card.dashboard-card .card-header h5 {
    font-size: 12px;
    font-weight: 400;
    flex-grow: 1;
}
.card.dashboard-card .card-header h1 {
    font-size: 12px;
    font-weight: 400;
    flex-grow: 1;
}
.card.dashboard-card .card-header button{
   line-height: 1;
}

.card.dashboard-card .card-header h5 a {
    background-color: #f5f5f5;
    color: #353535;
    display: block;
    padding: 5px 10px;
    text-decoration: none;
    border-radius: 1px;
    transition: 0.5s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-bottom: 1px solid #e5e5e5;
}
.card.dashboard-card .card-header h1 a {
    background-color: #f5f5f5;
    color: #353535;
    display: block;
    padding: 5px 10px;
    text-decoration: none;
    border-radius: 1px;
    transition: 0.5s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-bottom: 1px solid #e5e5e5;
}
.card.dashboard-card.no-bg .card-header h5 a,
.card.dashboard-card.no-bg .card-body {
    background: none;
    padding-right: 0;
}
.card.dashboard-card.no-bg .card-header h1 a,
.card.dashboard-card.no-bg .card-body {
    background: none;
    padding-right: 0;
}
.card.dashboard-card.no-bg .card-header h5 a[aria-expanded="true"] > .fa-folder:before {
    content: "\f07c";
}
.card.dashboard-card.no-bg .card-header h2 a[aria-expanded="true"] > .fa-folder:before {
    content: "\f07c";
}

.card.dashboard-card .card-header h5 a .card-header-date {
    font-size: 12px;
    color: #2972ad;
    display: inline-block;
    width: 70px;
}
.card.dashboard-card .card-header h1 a .card-header-date {
    font-size: 12px;
    color: #2972ad;
    display: inline-block;
    width: 70px;
}
.card.dashboard-card .card-header h5 a .insurance {
    font-size: 12px;
    color: #2e7fc1;
    display: inline-block;
    font-weight: 500;   
}
.card.dashboard-card .card-header h1 a .insurance {
    font-size: 12px;
    color: #2e7fc1;
    display: inline-block;
    font-weight: 500;   
}
.card.dashboard-card .card-header h5 a .title {
    font-size: 12px;
    color: #2e7fc1;
    display: inline-block;
    font-weight: 500;   
}
.card.dashboard-card .card-header h1 a .title {
    font-size: 12px;
    color: #2e7fc1;
    display: inline-block;
    font-weight: 500;   
}

.card.dashboard-card .card-header h5 a .card-header-date-time {
    font-size: 12px;
    color: #2972ad;
    display: inline-block;
    width: 135px;
}
.card.dashboard-card .card-header h1 a .card-header-date-time {
    font-size: 12px;
    color: #2972ad;
    display: inline-block;
    width: 135px;
}

.card.dashboard-card .card-header h5 a:hover,
.card.dashboard-card .card-header.active h5 a {
    /* color: #ffffff; */
    background-color: rgba(46, 127, 193, 0.3);
}
.card.dashboard-card .card-header h1 a:hover,
.card.dashboard-card .card-header.active h1 a {
    /* color: #ffffff; */
    background-color: rgba(46, 127, 193, 0.3);
}
.card.dashboard-card.no-bg .card-header h5 a:hover {
    background: none;
}
.card.dashboard-card.no-bg .card-header h1 a:hover {
    background: none;
}
.card.dashboard-card .card-body {
    font-size: 12px;
    background-color: rgba(0,0,0,.015);
    padding: 5px 10px;
    border: 1px solid rgba(0,0,0,0.025);
    border-top: none;
}

.card.dashboard-card .card-body p {
    margin: 0;
    color: #9b9b9b;
}

.card.dashboard-card .card-body p + p {
    margin-top: 2px;
}

.card.dashboard-card .card-body p strong {
    font-weight: normal;
    color: #252525;
    margin-left: 6px;
}

.table-container {
    width: 100%;
    overflow: auto;
    flex-grow: 1;
}

.table-heading {
    font-size: 14px;
    color: #2972ad;
    margin-top: 0px;
    line-height: normal;
    margin-bottom: 4px;
}

.dashboard-tabs > .nav-tabs {
    height: 30px;
    flex-shrink: 0;
    border-radius: 1px 1px 0 0;
    padding: 5px 10px 0 10px;
    border: none;
    background: -moz-linear-gradient(top, rgba(0,0,0,0.03) 0%, rgba(0,0,0,0.0) 100%);
    background: -webkit-linear-gradient(top, rgba(0,0,0,0.03) 0%,rgba(0,0,0,0.0) 100%);
    background: linear-gradient(to bottom, rgba(0,0,0,0.03) 0%,rgba(0,0,0,0.0) 100%);
    filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#00000000', endColorstr='#0d000000',GradientType=0 );
}

.dashboard-tabs > .nav-tabs > .nav-item > .nav-link {
    color: #454545;
    font-size: 13px;
    line-height: 25px;
    padding: 0 8px;
    border: none;
}

.dashboard-tabs > .nav-tabs > .nav-item > .nav-link.active {
    background-color: #2ebd6b;
    color: #ffffff;
    font-weight: 400;
    /* margin-top: 7px;
    line-height: 28px; */
    border-radius: 2px 2px 0 0;
}

.dashboard-tabs > .tab-content, .dashboard-tabs > .tab-content>.active {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.form-row>.col, .form-row>[class*=col-] {
    line-height: 1.25;
}

.scheduler-left {
    background-color: rgba(235,242,249,0.8);
    flex-shrink: 0;
    padding: 8px;
    width: 206px;
    display: flex;
}

.scheduler-right {
    flex-grow: 1;
    padding-left: 4px;
    overflow: auto;
}

ngb-datepicker {
    background-color: #fff;
    font-size: 13px;
}

ngb-datepicker .ngb-dp-day {
    border-radius: 0;
    box-shadow: none !important;
    border: none;
}

.btn-sm.custom {
    padding: 3px 6px;
    font-size: 11px;
    line-height: 14px;
    border-radius: 1px;
}

.scheduler-container {
    border-collapse: separate;
}

.scheduler-container .scheduler-time {
    width: 70px;
    min-width: 70px;
    height: 90px;
    text-align: center;
    font-size: 12px
}

.scheduler-container .appointment {
    min-width: 230px;
    max-width: 230px;
    height: 90px;
    vertical-align: top;
}

.scheduler-container .break-time {
    font-size: 13px;
    height: 60px;
    text-align: center;
    vertical-align: middle;
    background-color: rgb(178, 183, 199);
}

.scheduler-container .appointment-box {
    display: flex;
    flex-direction: column;
    height: 100%;
}

.scheduler-container .appointment-box.pending {
    background-color: #c3e6cb;
}

.scheduler-container .appointment-box.block {
    background-color: #f5c6cb;
}

.scheduler-container .appointment-box .title {
    background-color: #2e7fc1;
    font-size: 13px;
    color: #fff;
    text-align: center;
    padding: 2px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

.scheduler-container .appointment-box .title-highlited {  
    background-color: #ffc107;    
}


.scheduler-container .appointment-box .title .status-box {
    width: 20px;
    height: 20px;
    line-height: 16px;
    padding: 2px;
}

.appointment-box .btn-patient  {
    color: #ffffff;
    text-decoration: none;
    background: 0;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: 0.5s;
}
.appointment-box .btn-patient-heighlighted  {
    color: #05579b ;    
}
.appointment-box .btn-patient > button:hover {
    color: #9e9e9e;
}

.appointment-box .title .btn-link {
    background: none;
    border: none;
    color: #ffffff;
    cursor: pointer;
}

.appointment-box .title .btn-link:focus,
.appointment-box .title .btn-link:active {
    box-shadow: none;
}

.scheduler-container .appointment-box .content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 4px;
}

.scheduler-container .appointment-box .status {
    font-size: 12px;
    margin: 0;
    line-height: 12px;
    text-align: right;
    color: #353535;
}

.scheduler-container .appointment-box .type {
    font-size: 12px;
    margin: 0;
    line-height: 12px;
    color: #353535;
}

.scheduler-container .appointment-box .info {
    font-size: 12px;
    margin: 3px 0;
    line-height: 13px;
    height: 26px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}



.dropdown-menu.custome-menu{    
    background-color: #f5f7fb;
    margin: 0;
    font-size: 11px;
    border-radius: 1px;
    border: none;
    box-shadow: 0 0 8px rgba(0,0,0,0.25);
}

.dropdown-menu.custome-menu .dropdown-item {
    padding: 3px 10px ;
}

.dropdown-menu.custome-menu .dropdown-divider {
    margin: 1px 0;
}




.dropdown-menu.dropdown-menu-left {
    left: auto !important;
    right: 0 !important;
}

.dropdown-menu.dropdown-menu-right {
    left: 0 !important;
    right: auto !important;
}

.dropdown-menu.schedular-card {
    background-color: #f5f7fb;
    padding: 0;
    margin: 0;
    font-size: 11px;
    border-radius: 1px;
    border: none;
    box-shadow: 0 0 8px rgba(0,0,0,0.2);
}

.dropdown-menu.schedular-card .dropdown-item {
    display: flex;
    padding: 0;
    align-items: center;
    height: 25px;
}

.dropdown-menu.schedular-card .dropdown-item > i {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 25px;
    height: 25px;
    position: relative;
    margin-right: 10px;
    padding-right: 1px;
}

.dropdown-menu.schedular-card .dropdown-item > i::after {
    position: absolute;
    content: "";
    top: 0px;
    right: 0px;
    width: 1px;
    bottom: 0px;
    background-color: rgba(255, 255, 255, 1);
    border-right: 1px solid rgba(0, 0, 0, .15);
}
.dropdown-item:hover{
    background-color: rgba(235,242,249,1);
}
