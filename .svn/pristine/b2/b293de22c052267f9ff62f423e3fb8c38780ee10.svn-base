body {
    font-family: 'Roboto';
    /* background-color: #edeff5; */
    background-color: #eff7f8;
}

.content-wrapper {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    height: 100vh;
    overflow: hidden;
}

.content-wrapper .right-content {
    display: flex;
    flex-direction: column;
    flex: 1;
}

.main-app {
    padding: 4px 8px;
    flex-grow: 1;
    overflow: auto;
}


/**************************** Main Table without border ****************************/
.table.light-blue-striped {
    margin-bottom: 0;
}

.table.light-blue-striped,
.table.light-blue-striped thead th,
.table.light-blue-striped tbody td {
    border: none;
    white-space: nowrap;
}

.table.light-blue-striped thead tr {
    font-family: 'Roboto';
    font-size: 12px;
    color: #252525;
    font-weight: 500;
    background-color: rgba(213, 229, 243, .8);
    height: 25px;
}

.table.light-blue-striped tbody tr {
    font-family: 'Roboto';
    font-size: 12px;
    color: #353535;
    font-weight: 400;
    height: 25px;
}

.table.light-blue-striped tbody tr:nth-of-type(odd) {
    background-color: rgba(243, 247, 251, .8);
}

.table.light-blue-striped tbody tr.active {
    color: #101010;
    background-color: #c1d9ed;
}

.table.light-blue-striped thead th p,
.table.light-blue-striped tbody td p,
.table.light-blue-striped thead th span,
.table.light-blue-striped tbody td span {
    display: block;
    margin: 0;
    white-space: nowrap;
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.table td, .table th {
    padding: 4px 8px;
}
.table td  pre{
    font-family: inherit;
    font-size: 12px;
    margin-bottom: 2px;
    color: unset;
    overflow: inherit;
    text-overflow: inherit;
}



/**************************** Table DANGER with border ****************************/
.table.table-danger thead tr {   
    color: #721c24 !important;
    background-color: #f8d7da !important;
    border-bottom: 1px solid #f5c6cb !important;
}

.table.table-danger tbody tr {
    color: #7c2029 !important;   
    border-bottom: 1px solid #f5c6cb !important;
}

.table.table-danger tbody tr:nth-of-type(odd) {
    background-color:  #fcfcfc99 !important;
}
.table.table-danger tbody tr:nth-of-type(even) {
    background-color:  #fcfcfcbf !important;
}
/****************** END Table DANGER ********************************************/

/**************************** Table WARNING with border ****************************/
.table.table-warning thead tr {   
    color: #856404 !important;
    background-color: #fff3cd !important;
    border-bottom: 1px solid #ffeeba !important;
}

.table.table-warning tbody tr {
    color: #866709 !important;   
    border-bottom: 1px solid #ffeeba !important;
}

.table.table-warning tbody tr:nth-of-type(odd) {
    background-color:  #fcfcfc99 !important;
}
.table.table-warning tbody tr:nth-of-type(even) {
    background-color:  #fcfcfcbf !important;
}
/****************** END Table WARNING ********************************************/

/**************************** Table INFO with border ****************************/
.table.table-info thead tr {   
    color: #0c5460 !important;
    background-color: #d1ecf1 !important;
    border-bottom: 1px solid #bee5eb !important;
}

.table.table-info tbody tr {
    color: #105864 !important;   
    border-bottom: 1px solid #bee5eb !important;
}

.table.table-info tbody tr:nth-of-type(odd) {
    background-color:  #fcfcfc99 !important;
}
.table.table-info tbody tr:nth-of-type(even) {
    background-color:  #fcfcfcbf !important;
}
/****************** END Table INFO ********************************************/


/**************************** Main Table with border ****************************/
.table.light-blue-striped-border {
    margin-bottom: 0;
}

.table.light-blue-striped-border,
.table.light-blue-striped-border thead th,
.table.light-blue-striped-border tbody td {
    border: none;
    white-space: nowrap;
}
.table.td-normal-wrap tbody td {
    white-space:normal;
}
.table.light-blue-striped-border thead tr {
    font-family: 'Roboto';
    font-size: 12px;
    color: #252525;
    font-weight: 500;
    /* background :linear-gradient(to bottom,#a0d5a7 0,#cee7d4 100%); */
    background :#bae2ff;
    height: 27px;
    border-bottom: 1px solid #073e7a;
}

.table.light-blue-striped-border tbody tr {
    font-family: 'Roboto';
    font-size: 12px;
    color: #353535;
    font-weight: 400;
    height: 27px;
    border-bottom: 1px solid #e6eff8;
}

.table.light-blue-striped-border tbody tr:last-child {
    border-bottom: none;
}

.table.light-blue-striped-border tbody tr:nth-of-type(odd) {
    background-color: rgba(235,242,249,0.5);
}

.table.light-blue-striped-border tbody tr.active {
    color: #101010;
    background-color: #c1d9ed;
}

.table.layout-fixed.light-blue-striped-border {
    margin-bottom: 0;
    table-layout: fixed;
}

.table.layout-fixed.light-blue-striped-border,
.table.layout-fixed.light-blue-striped-border thead th,
.table.layout-fixed.light-blue-striped-border tbody td {
    border: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}


/**************************** Main Table with ROW Column border ****************************/
.table.light-blue-striped-row-column-border {
    margin-bottom: 0;
    
    font-family: 'Roboto';
    font-size: 12px;
}

.table.light-blue-striped-row-column-border,
.table.light-blue-striped-row-column-border thead th,
.table.light-blue-striped-row-column-border tbody td {    
    
    border: 1px solid #c1d9ed;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.table.light-blue-striped-row-column-border thead tr {    
    color: #252525;
    font-weight: 500;
    background-color: rgba(213,229,243,0.8);
    height: 27px;
    border: 1px solid #c1d9ed;
}

.table.light-blue-striped-row-column-border tbody tr {   
    color: #353535;
    font-weight: 400;
    height: 27px;
    border: 1px solid #c1d9ed;
}

/*
.table.light-blue-striped-row-column-border tbody tr:last-child {
    border-bottom: none;
}
*/

.table.light-blue-striped-row-column-border tbody tr:nth-of-type(odd) {
    background-color: rgba(235,242,249,0.5);
}

.table.light-blue-striped-row-column-border tbody tr.active {
    color: #101010;
    background-color: #c1d9ed;
}

.table.layout-fixed.light-blue-striped-row-column-border {
    margin-bottom: 0;
    table-layout: fixed;
}


/******************************************/

.table td, .table th {
    padding: 4px 8px;
}

.table .table-link-btn {
    color: #007bff;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
}

.table .table-link-btn:hover {
    color: #0056b3;
}

.table .table-td-checkbox {
    vertical-align: middle;
    height: 16px;
    width: 16px;
}

.table .table-group-row{
    background-color: #17a2b833 !important;
}
.table .table-td-select {
    background-color: #fcfcfc;
    font-size: 12px;
    line-height: normal;
    padding: 1px 5px;
    min-height: 20px;
    border-radius: 3px;
    height: auto;
    resize: none;
    border: 1px solid #ced4da;
    color: #495057;
}

.table .table-td-input {
    background-color: #fcfcfc;
    font-size: 12px;
    line-height: normal;
    padding: 1px 5px;
    min-height: 21px !important;
    border-radius: 3px;
    height: auto;
    resize: none;
    border: 1px solid #ced4da;
    color: #495057;
}

.table .table-td-date-input {
    background-color: #fcfcfc;
    font-size: 12px;
    line-height: normal;
    padding: 1px 5px;
    min-height: 21px !important;
    border-radius: 3px;
    height: 21px;
    resize: none;
    border: 1px solid #ced4da;
    color: #495057;
}
.table .table-td-date-button {   
    height: 21px;    
    min-height: 21px !important;
    padding: 0px 5px !important;
}

.table .table-td-input-disabled {    
    background-color: #e9ecef !important;
}



.table .is-invalid{
    border-color: #dc3545;
}

.table .required{
    background-color: #f9f9e4;
}

.table .table-td-input-group{
    height: 21px !important;
    flex-wrap: nowrap;
}

.table .input-group-prepend{
    height: 21px !important;
}


.table .table-td-input-group-text{
    padding-left: 2px !important;
    padding-right: 2px !important;
    font-size: 12px !important;
    min-height: 21px !important;
}

.td-payment-source{
    background-color: #d0ecf14a;    
    border-right: 1px solid #e6eff8 !important;
}

.th-bg {
    color: #2e7fc1;
    font-weight: 500;
    background-color: rgba(213,229,243,1);
}


.find-patient-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.patient-summary {
    height: 45px;   
    background-color:#1960A3;
    margin: 0;
    border-radius: 1px;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

.patient-summary-green {
    background-color: #26ae91;
}


.patient-summary .summary-info {
    height: 45px;
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.patient-summary .summary-info .close-button {
    padding-right: 2px;
    margin: 0px;
    height: 100%;
}

.summary-info .patient-pic {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    margin-left: 8px;    
}

.summary-info .info-box {
    padding-left: 16px;
    flex-grow: 1;
}

.info-box h3 {
    font-size: 16px;
    font-weight: 400;
    color: #ffffff;
    margin: 0;
}

.info-box p {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    font-weight: 400;
}

.info-box p i {
    color: rgba(255, 255, 255, 1);
    padding-right: 8px;
}

.info-box p strong {
    color: rgba(255, 255, 255, 1);
    margin: 0;
    font-weight: 400;
}

.summary-info .status {
    margin: 5px 0;
    padding: 0 12px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-left: 1px solid rgba(255, 255, 255, 0.2);
}

.summary-info .status h4 {
    font-size: 15px;
    font-weight: 400;
    color: #fde049;
    margin: 0;
}

.summary-info .status p {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
    font-weight: 300;
}

.insurance-summary-box {
    background-color: rgba(255, 255, 255, 0.9);
    height: 35px;
    border-radius: 1px;
    margin: 8px 0 4px;
    padding: 0 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.insurance-summary-box .item {
    font-size: 13px;
    font-weight: 400;
    color: #505050;
    margin: 0;
    flex-shrink: 0;
}

.insurance-summary-box .item + .item {
    padding-left: 24px;
}

.insurance-summary-box .item strong {
    font-weight: 500;
    color: #353535;
    padding-right: 8px;
}

.nav.insurance-summary-nav {
    flex: 1;
}

.nav.insurance-summary-nav .nav-link {
    font-size: 13px;
    padding: 0;
}

.nav.insurance-summary-nav .nav-link + .nav-link {
    padding-left: 16px;
}

.nav.dashboard-nav {
    flex: 1;
    padding: 0 16px;
}

.nav.dashboard-nav .nav-link {
    color: #454545;
    font-size: 14px;
    padding: 0;
    line-height: 35px;
    padding: 0 8px;
    transition: 0.5s;
}

.nav.dashboard-nav .nav-link:hover {
    color: #2e7fc1;
}

.nav.dashboard-nav .nav-link.active {
    background-color: #c1d9ed;
    color: #151515;
    font-weight: 400;
    margin-top: 7px;
    line-height: 28px;
    border-radius: 2px 2px 0 0;
}

.dashboard-sub-nav {
    background-color: #74acd8;
    height: 25px;
    padding: 0 5px;
    font-size: 12px;
    color: #ffffff;
    flex-shrink: 0;
    display: flex;
    align-items: center;
}



