.patient-search-bar {
    height: 40px;
    background-color: #0073aa;
    margin-bottom: 8px;
    border-radius: 1px;
    display: flex;
    flex-direction: row;
}

.patient-search-bar .normal-search {
    flex: 6;
    border-right: 1px solid rgba(255,255,255,.25);
    padding: 0 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.patient-search-bar .normal-search form {
    flex-grow: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.patient-search-bar h4 {
    font-size: 14px;
    color: #ffffff;
    font-weight: 400;
    margin: 0;
    flex-shrink: 0;
    line-height: normal;
}

.patient-search-bar .form-control {
    font-size: 13px;
    width: auto;
    height: 26px !important;
    line-height: normal;
    padding: 0 8px;
    margin: 0 0 0 6px;
    flex-grow: 1;
    border: none;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 2px;
}

.patient-search-bar .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    background-color: #2ebd6b;
    width: 30px;
    height: 26px;
    border: none;
    font-size: 16px;
    line-height: normal;
    padding: 0;
    margin: 0 0 0 6px;
    border-radius: 2px;
    flex-shrink: 0;
}

.patient-search-bar .advance-search {
    flex: 4;
    padding: 0 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.patient-search-bar .advance-search form {
    flex-grow: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
}



.dashboard-sub-nav.encounter {
    background-color: #c1d9ed;
}

.dashboard-sub-nav.encounter .color-box
{
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 2px;
}

.legend-container{
    display: inline-flex;
    margin-top: 4px;
    padding-left: 8px;
    padding-right: 8px;
    align-items: center!important;
}
.legend-container .color-box{
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 2px;
}
.legend-container p{   
    margin: 0px;
    padding-left: 2px;
    padding-right: 8px;  
}



.dashboard-sub-nav.encounter p {
    font-weight: 500;
    color: #252525;
    margin: 0 10px 0 4px;
}

.dashboard-title .new-encounter {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin: 0 16px;
    flex-grow: .25;
}

.new-encounter h4 {
    font-size: 12px;
    color: #205987;
    font-weight: 500;
    margin: 0;
    flex-shrink: 0;
    white-space: nowrap;
}

.new-encounter .form-control {
    font-size: 13px;
    background-color: #eaf2f9;
    height: auto !important;
    padding: 2px 6px;
    border: none;
    border-radius: 2px;
    margin: 0 6px;
}

.new-encounter .btn {
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 2px;
}

.insurance-summary-box .btn {
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 2px;
}

.form-row.form-dashboard {
    margin-right: -4px;
    margin-left: -4px;
}

.form-row.form-dashboard > .col,
.form-row.form-dashboard > [class*=col-],
.form-row.form-dashboard > .form-group {
    padding-right: 4px;
    padding-left: 4px;
}

.form-row.form-dashboard .form-group {
    margin-bottom: 0;
}

.form-group > label {
    font-weight: 400;
    font-size: 12px;
    margin-bottom: 0;  
}

.form-group .col-form-label, .col-form-label {
    font-weight: 400;
    font-size: 12px;
    margin-bottom: 0;
    padding-top: 2px;
    padding-bottom: 0;
}

.form-group .label-detail {
    font-size: 12px;
    margin-bottom: 0;
    padding-top: 2px;
    padding-bottom: 0;
}

.form-group .col-form-label.blue {
    color: #2e7fc1;
}

.form-group .col-form-label.required {
    position: relative;
}

.form-group .col-form-label.required::after {
    content: "*";
    position: absolute;
    right: -8px;
    top: 0;
    color: #dc3545;
}

.form-control.required:not(:disabled),
.form-group > .form-control.required:not(:disabled),
.form-group .input-group >.form-control.required:not(:disabled) {
    background-color: #f9f9e4 !important;
}



.form-group >.form-control,
.form-group >.input-icon > .form-control,
.form-group .input-group > .form-control,
.form-flex .input-group > .form-control
.form-group.row > [class^="col-"] > .form-control {
    background-color: #fcfcfc;
    font-size: 12px;
    line-height: normal;
    padding: 2px 8px;
    min-height: 24px;
    border-radius: 3px;
    height: auto;
    resize: none;
}

.form-control.text-input-skin {
    border-top: none;
    border-right: none;
    border-left: none;
    border-radius: 0;
    padding: 2px 6px;
}

.form-group > .form-control:focus,
.form-group.row > [class^="col-"] > .form-control:focus,
.form-group > .input-icon > .form-control {
    box-shadow: none;
}

.form-group > .btn,
.form-row.form-dashboard .form-group > .btn,
.input-group > .input-group-btn > .btn {
    font-size: 14px;
    line-height: 16px;
    padding: 3px 10px;
    border-radius: 3px;
}

.input-group > .input-group-btn > .btn {
    font-size: 12px;
    line-height: 18px;
    padding: 2px 8px;
    min-height: 24px;
    border-radius: 0 3px 3px 0;
    vertical-align: top;
}

.input-group > .form-control {
     /* border-radius: 3px 0 0 3px;*/
   /* border-right: none;*/
    box-shadow: none;
}

/*
.form-row.form-dashboard .form-group > .input-group > .form-control {
    border-radius: 3px 3px 3px 3px;
}
*/

.form-control:disabled{
    background-color: #e9ecef !important;
}

.select-option-disabled{
    background-color: #e9ecef  !important;
}



/*
.form-row.form-dashboard .form-group > .input-group > .form-control:focus {
    box-shadow: none;
}
*/

.input-group > .form-control:not(:last-child) {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
   /*  border-right: none;*/
}

.input-group > .form-control:not(:first-child) {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}

.input-group > .form-control:not(:first-child):not(:last-child) {
    border-radius: 0;
}



.input-group>.input-group-prepend>.input-group-text{
    font-size: 12px;
    line-height: normal;
    padding: 2px 8px;
    min-height: 24px;        
   /* border-top-left-radius: 3px;*/
   /* border-bottom-left-radius: 3px;*/
   /* border-radius: 3px;*/
    height: auto;
    resize: none;
}

.input-group>.input-group-append>.btn, .input-group>.input-group-append>.input-group-text, 
.input-group>.input-group-prepend:first-child>.btn:not(:first-child), 
.input-group>.input-group-prepend:first-child>.input-group-text:not(:first-child), 
.input-group>.input-group-prepend:not(:first-child)>.btn, 
.input-group>.input-group-prepend:not(:first-child)>.input-group-text {
    border-radius: 0 3px 3px 0;
}
.input-group>.input-group-append:last-child>.btn:not(:last-child):not(.dropdown-toggle), 
.input-group>.input-group-append:last-child>.input-group-text:not(:last-child), 
.input-group>.input-group-append:not(:last-child)>.btn, 
.input-group>.input-group-append:not(:last-child)>.input-group-text, 
.input-group>.input-group-prepend>.btn, 
.input-group>.input-group-prepend>.input-group-text {
    border-radius: 3px 0 0 3px;
    
}
/*

.form-row.form-dashboard .form-group > .input-group > .input-group-prepend>.input-group-text:not(:last-child) {
    border-top-right-radius: 0 !important;
    border-bottom-right-radius: 0 !important;

}

.form-row.form-dashboard .form-group > .input-group > .input-group-prepend>.input-group-text:not(:first-child) {
    border-top-left-radius: 0 !important;
    border-bottom-left-radius: 0 !important;
}

.form-row.form-dashboard .form-group > .input-group > .input-group-prepend>.input-group-text:not(:first-child):not(:last-child) {
    border-radius: 0 !important;
}

