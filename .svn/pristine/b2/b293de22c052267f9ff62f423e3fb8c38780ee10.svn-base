}


.has-search .form-control {
    padding-right: 24px !important;
}

.has-search .form-control-feedback {
    position: absolute;
    right: 7px;
    z-index: 2;
    display: block;
    width: 22px;
    height: 22px;
    line-height: 22px;
    font-size: 14px;
    text-align: center;
    pointer-events: none;
    color: #a1b7ca;
}

.has-filter .form-control {
    padding-left:20px !important;
}
.has-filter .form-control-feedback {
   
    position: absolute;
    z-index: 2;
    display: block;
    width: 22px;
    height: 22px;
    line-height: 22px;
    text-align: center;
    pointer-events: none;
    color: #2e7fc191;
    padding-left: 4px;
    font-size: 14px;
}


/*** ICON ADDON */
.icon-addon {
    position: relative;
    color: #555555bd;
    display: block;
}
.icon-addon .fa {
    position: absolute;
    z-index: 2;
    left: 10px;
    font-size: 14px;
    width: 20px;
    margin-left: -2.5px;
    text-align: center;
    padding: 10px 0;
    top: 1px
}
.icon-addon.addon-sm .form-control
{    
    padding-left: 20px;
}
.icon-addon .form-control {
    padding-left: 20px;
    float: left;
    font-weight: normal;
}
.icon-addon .fa {
    margin-left: 0;
    font-size: 12px;
    left: 2px;
    top: -4px;
}

.icon-addon .form-control:focus + .fa,
.icon-addon:hover .fa {
    color: #2e7fc1;
}
/*** END ICON ADDON */

.node-wrapper {
    align-items: center !important;
}
/*** END ICON ADDON */

