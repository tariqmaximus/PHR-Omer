/**************************************/
.div-column {        
    padding: 8px;   
    display: flex;
}


 .modules-entry-details{
    font-size: 12px;
    color: #3C7EC8;
    font-style: italic;
    font-weight: normal;
    text-align: left;
 }
 .chart-disable-row{
    background-color: #ddd;
    cursor: not-allowed;
  }
 /**************************************/

 .patient-info-top-bar {
    background-color: #b3d5e5;
    height: 28px;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    font-size: 13px;
    overflow: hidden;
    font-weight: 500;
}

 .auto-height{
     height: auto !important;
 }

 .full-height{
    height: 100% !important;
 }

 .payment-plan {   
    margin: 0;   
    max-height: 300px;
    overflow: auto;
}

.payment-plan p {
    font-size: 12px; 
    margin: 0;
    font-weight: 400;
}

.payment-plan hr {
   margin-top: 3px;
   margin-bottom: 5px;
}

.payment-plan h6 {
    font-size: 13px;
    margin-bottom: 2px;
 }

 .dispaly-flex{
     display: flex;
     flex-direction: column;
 }

.flex-grow-1{
    flex-grow: 1;
}

/**********  Encounter Module ****************** */


.form-group-column-view {
    display: flex;
    flex-flow: column;
    font-size: 12px;
    margin: 2px 10px
}

.form-group-column-view .title {
    color: #2e7fc1;    
    font-weight: 400;   
}

.form-group-column-view .value {
    flex-grow: 1;
    color: #101010;
    font-weight: 400;   
}

.form-group-row-view {
    display: flex;
    flex-flow: row;
    font-size: 12px;
    margin: 2px 10px
}

.form-group-row-view .title {
    color: #2e7fc1;
    font-weight: 500;
}

.form-group-row-view .value {
    flex-grow: 1;
    color: #101010;
    font-weight: 400;
    padding-left: 6px;
}

.module-view-headding {
    color: #2972ad;    
    font-weight: 400;   
}

.module-view-value {
    flex-grow: 1;
    color: #101010;
    font-weight: 400;
    display: flex;    
}
.border-right-vertical{
    border: none !important;
    border-right: 0.08rem solid #dee2e6 !important;
}
.border-top-vertical{
    border: none !important;
    border-top: 0.08rem solid #dee2e6 !important;
}
.bg-color-disable{
    background-color: #cee6f8 !important;
}

/************ End Chart Module **************** */

.form-edit-sub-heading-without-border {
    border-bottom: 0px !important;
}
.bg-notes{
    background-color: #f1ac5b1c;
  }

.scroll-vertical {
    overflow-y: auto;
}
/************************* LIST ************************ */
.list-no-bullet{
    list-style: none;
}
.list-bullet-circle{
    list-style-type: circle;
}
.list-bullet-square{
    list-style-type: square;
}
.list-bullet-upper-roman{
    list-style-type: upper-roman;
}
.list-bullet-lower-alpha{
    list-style-type: lower-alpha;
}
.list-with-checkbox{
    padding-left: 8px !important;
}

/************************* END LIST ************************ */
.overflow-visible{
    overflow: visible !important;
}

.rounded-custom{
    border-radius:  3px !important;
}
.rounded-top-right{
    border-radius: 0 !important;
    border-top-right-radius: 3px !important;
}

.alertIco{
    font-size: 42px;
    opacity: 0.7;
}

.btn-md{
    font-size: 14px !important
}
.fa-md{
    font-size: 14px !important
}


.header-fixed {
    width: 100% 
}


.btn-add {    
    color: #6c757d!important;
  }
.btn-add:hover {    
    color: #28a745 !important;
}

.btn-delete {    
    color: #6c757d!important;
  }
.btn-delete:hover {    
    color: #dc3545 !important;
}

.cursor-pointer {cursor: pointer; }
.cursor-default {cursor: default; }
.cursor-not-allowed  { cursor: not-allowed !important; }

.disabled, button[disabled] {
    pointer-events: none;
    opacity: 0.7;
 }

 .dashboard-title .btn-sm {
    padding: 4px 10px;
    font-size: 13px;
    line-height: 1;
    border-radius: .2rem;
}

.node-content-wrapper {
    color: #202020 !important;
    padding: 2px 5px;
    font-size: 14px
}

.node-content-wrapper > tree-node-content span {
    color: #404040 !important;
}

.tree-node-level-1 > tree-node-wrapper .node-wrapper {
    background-color: rgba(46, 127, 193, .1);
    padding: 0 8px !important;
    border-radius: 3px;
}

.toggle-children-wrapper.toggle-children-wrapper-expanded .toggle-children,
.toggle-children-wrapper.toggle-children-wrapper-collapsed .toggle-children {
    background-image: none !important;
    top: -6px !important;
    left: -1px !important;
    transform: rotate(0deg);
}

.toggle-children-wrapper .toggle-children::after {
    font-family: "Font Awesome 5 Free";
    font-size: 13px;
    position: absolute;
    top: 0;
    left: 0;
    color: #0073aa;
}

.toggle-children-wrapper.toggle-children-wrapper-expanded .toggle-children::after {
    content: "\f146";
}

.toggle-children-wrapper.toggle-children-wrapper-collapsed .toggle-children::after {
    content: "\f0fe";
}

.node-content-wrapper-active, 
.node-content-wrapper-focused, 
.node-content-wrapper:hover {
    background: none !important;
    box-shadow: none !important;
}

.tree-children {
    background-color: #fcfcfc;
    padding-left: 12px;
}

.tree-children .node-content-wrapper {
    font-size: 13px;
    /* padding: 0; */
}

.tree-children .node-content-wrapper > tree-node-content span {
    color: #666666 !important;
}

.tree-node-level-2.tree-node.tree-node-leaf.tree-node-active .node-wrapper,
.tree-node-level-3.tree-node.tree-node-leaf.tree-node-active .node-wrapper,
.tree-node-level-4.tree-node.tree-node-leaf.tree-node-active .node-wrapper {
    background-color: #2ebd6b;
    border-radius: 3px;
    align-items: center;
    margin-right: 8px;
}
.tree-node-level-2.tree-node.tree-node-leaf.tree-node-active .node-wrapper span,
.tree-node-level-3.tree-node.tree-node-leaf.tree-node-active .node-wrapper span,
.tree-node-level-4.tree-node.tree-node-leaf.tree-node-active .node-wrapper span {
    color: #ffffff !important;
}

.note-box-background{
    background-color: #ffc1070d !important;
}

.flex-wrap-nowrap {
    flex-wrap: nowrap;
}

.btn.btn-sub-nav {
    height: 25px;
    font-size: 13px;
    padding: 3px 8px;
    line-height: 1;
}

.popover-light-blue {
    border: 1px solid #c5d7e3;
    background: rgb(237, 243, 250);
}
.popover-light-blue .arrow::after {
    /* border-top-color: rgb(237, 243, 250); */
    border-right-color: rgb(237, 243, 250);
}
.popover-light-blue .popover-header {
    background-color: #aad0f4;
    font-size: 15px;
    padding: .4rem .6rem;
}


.pointer {cursor: pointer; }


.HTMLPrevAlign tr td {text-align: center !important;}
.HTMLPrevMargin tr td p{margin-bottom: 0rem !important;}
.HTMLPrevDiv p{margin-bottom: 0rem !important;}

.ck p{margin-bottom: 0rem !important;}
#templateRichEditorEdit{width:100%;}
#templateRichEditorView{width:100%;}

.ql-toolbar.ql-snow {
    flex-shrink: 0;
}

.ql-container.ql-snow {
    flex-grow: 1;
    overflow: auto;
}

.overflow-hidden {
    overflow:  hidden !important;
}

.pt-1-px {
    padding-top: 1px !important;
}

.lab-order-add-all-btn {
    position: absolute;
    right: 0;
    top: -15px;
}

.modal-header.custom-modal-header {
    background-color: #0073aa;
    color: #fff;
    height: 32px;
    padding: 0 4px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.modal-dialog.modal-md {
    max-width: 700px !important;
}

.left-toggle-menu {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 13px;
    font-weight: 500;
}

.z-100 {
    z-index: 100 !important;
}

.sm-modal-header {
    background-color: #0073aa;
    color: #fff;
    height: 30px;
    padding: 0 3px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.sm-modal-body {
    background-color: #ffffff;
    border-right: 1px solid #dee2e6;
    border-left: 1px solid #dee2e6;
    padding: 6px 8px;
}

 .login-main {
    /*background: url("../images/login-bg2.jpg") no-repeat;*/
    background-size: cover;
    width: 100vw;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
}

.login-main .login-box {
    background-color: rgba(212, 233, 245, .4);
    width: 350px;
    height: auto;
    border-radius: 10px;
    padding: 40px 25px;
    box-shadow: 0px 0px 10px rgba(46, 127, 193,.8);
}

.login-main .login-box .form-control {
    width: 100%;
    height: calc(2.25rem + 2px);
    padding: .375rem .75rem;
    font-size: 1rem;
    line-height: 1.5;
    color: #495057;
    background-color: #fff;
    background-clip: padding-box;
    border: 1px solid #ced4da;
    border-radius: .3rem;
}

.login-main .login-box .input-group > .form-control:not(:first-child) {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
} 
.login-main .login-box .btn-login {
    background-color: #2ebd6b;
    border-color: #2ebd6b;
    border-radius: .3rem;
}

.login-main .login-box .input-group>.input-group-prepend>.input-group-text {
    border-radius: .3rem 0 0 .3rem;
}

.login-main .login-box .input-group-text .fas {
    color: #2e7fc1;
}

.tabpanel-max-h-100 .tab-pane {
    max-height: 100%;
}

.radio-btns-bar {
    display: flex;
    background-color: #b3d5e6;
}

.radio-btns-bar .btn-group {
    display: flex;
}

.radio-btns-bar .btn {
    display: block;
    font-size: 12px;
    color: #454545;
    padding: 3px 10px;
    background-color: #b3d5e6;
    margin-right: 2px;
    transition: 0.5s;
    border-radius: 0;
    border: none;
    border-right: 1px solid rgba(255,255,255,.4);
}

.radio-btns-bar.green-sel .btn.active {
    color: #ffffff;
    background-color: #2ebd6b;
}

.radio-btns-bar.blue-sel .btn.active {
    color: #ffffff;
    background-color: #0073aa;
}

.btn.btn-cds-rule {
    height: 45px;
    width: 12px;
    padding: 0;
    border-radius: 0;
    border: none;
    color: #fff;
}

.cds-rule-popover {
    background: #ffffff;
    border-color: #d2b96c;
    width: auto;
    min-width: 500px;
    max-width: 800px;
    top: 83px !important;
    left: 58px !important;
}

.cds-rule-popover .popover-header {
    background-color: #ecd690;
    color: #101010;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 10px;
}

.cds-rule-popover .arrow::after {
    border-right-color: #ffffff;
}

.cds-rule-popover .popover-body {
    padding: 1px;
}

.cds-rule-popover .item-rule {
    background-color: #f8f0d6;
    color: #856404;
    font-size: 13px;
    font-weight: 500;
    padding: 2px 10px;
    border-radius: 1px;
    text-align: left;
}

.cds-rule-popover .item-rule + .item-rule {
    margin-top: 1px;
}

.cds-rule-popover .btn.btn-rule:hover {
    background-color: #ffeeba;
}
.btn-white{
    background-color: white;
}
.text-white{
    color: white;
}
.text-ehr-colour{
    color:#0073aa;
}


.login-new {
    width: 100%;
    height: 100vh;
    position: relative;
    background-image: url('../images/login-bg.jpg');
    background-size: cover;
}
.login-new::after {
    background-color: rgba(255,255,255,0.9);
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 50;
}

.login-new .login-page {
    position: relative;
    z-index: 60;
}

.login-new .login-page .header {
    background-color: rgba(255, 255, 255, 0.99);
    height: 45px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid #f1f1f1;
}

.login-new .login-page .login-body {
    display: flex;
    flex-grow: 1;
    align-items: center;
    justify-content: space-between;
}

.login-body .login-form {
    background: #ffffff;
    padding: 30px;
    border-radius: 1rem;

    margin-top: auto;
    margin-bottom: auto;
    width: 350px;
    /* background-color: rgb(255 255 255 / .9);
    border-radius: 1rem; */
    box-shadow: 0 0 10px 0 rgb(0 0 1 / 25%);
    /* padding: 2rem; */
}

.login-new .login-body .input-group-text {
    width: 40px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.login-new .login-body .input-group-text .fas {
    color: #2e7fc1;
}

.login-new .login-body .btn-login {
    /* border-radius: .3rem; */
    background-color: #3057A4!important;
    border-color: #0062cc!important;
    cursor: pointer !important;
    border-radius: 25px!important;
}

.login-new .login-body .form-control {
    width: 100%;
    /* height: calc(2.25rem + 2px); */
    /* padding: .375rem .75rem; */
    /* font-size: 1rem; */
    /* line-height: 1.5; */
    color: #495057;
    background-color: #fff;
    background-clip: padding-box;
    border: 1px solid #ced4da;


    font-size: 12px;
    line-height: normal;
    padding: 8px 12px;
    border-radius: 25px;
    height: auto;
    resize: none;
}

.features-box {
    position: relative;
    display: flex;
    flex-grow: 1;
    height: 100%;
    overflow: hidden;
}

.features-box .feature {
    display: flex;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 100%;
    transition: 0.7s;
}
.features-box .feature.active {
    left: 0;
}
.features-box .feature.right {
    left: 100% !important;
}
.features-box .feature.left {
    left: -100%;
}
.features-box .feature.transition-0 {
    transition: 0s;
}

.features-box .feature .feature-img {
    width: 160px;
}

.features-box .feature .title {
    font-size: 34px;
    font-weight: 300;
    color: rgba(255, 255, 255, .9);
}

.features-box .feature .fa-ul li + li {
    margin-top: 6px;
}

.text-app-green {
    color: #2ebd6b !important;
}

.text-app-red {
    color: #ff0000 !important;
}

.text-app-blue {
    color: #2e7fc1 !important;
}

.max-width-login {
    max-width: 1080px;
}
.maxWidth-login {
    max-width: 100%;
    padding: 0 15px;
}
.max-height-80 {
    max-height: 80px;
}

.login-new .login-page .footer {
    background-color: rgba(255, 255, 255, 0.99);
    /* height: 100px; */
    height: 30px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    border-top: 1px solid #f1f1f1;
}

.features-box .feature-nav {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
}

.features-box .feature-nav .feature-nav-btn {
    color: rgba(255, 255, 255, .8);
    background: none;
    padding: 0;
    margin: 0;
    border: none;
    transition: .5s;
    font-size: 13px;
}

.features-box .feature-nav .feature-nav-btn:hover {
    color: rgba(255, 255, 255, 1);
    cursor: pointer;
}

.features-box .feature-nav .feature-nav-btn.active {
    color: #2ebd6b;
}

.features-box .feature-nav .feature-nav-btn + .feature-nav-btn {
    margin-left: 10px;
}

.table-header-bg {
    background-color: rgba(213,229,243,0.8) !important;
}


th[sortable].desc:after, 
th[sortable].asc:after {
       font-family: 'Font Awesome 5 Free';
 
     /* >> Weight of the font (mandatory)
               - 400 for Regular and Brands symbols;
               - 900 for Solid symbols. */
    font-weight: 900;    
    padding-left: 2px;
    color: #2e7fc1;
}
th[sortable].desc:after{
    content: "\f309";
} 
th[sortable].asc:after {
    content: "\f30c";
}

