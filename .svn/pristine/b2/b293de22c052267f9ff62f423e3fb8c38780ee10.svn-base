} */

.dropdown-menu.schedular-card .dropdown-divider {
    margin: 1px 0;
}

.scheduler-time-btn {
    font-size: 12px;
    background-color: rgba(179, 208, 230, 0.6);
    display: flex;
    width: 100%;
    height: 100%;
    border: none;
    padding: 0;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: 0.5s;
}


.scheduler-time-btn-higlighted {    
    background-color: #ffc107;
}

.scheduler-time-btn-disabled {    
    background-color: rgba(230, 179, 179, 0.6);
    color: grey;
}


.scheduler-time-btn:hover {
    background-color: rgba(179, 208, 230, 1);
}

.scheduler-left .ngb-dp-day,
.scheduler-left .btn-light,
.scheduler-left .ngb-dp-weekday {
    width: 25px !important;
    height: 22px !important;
    line-height: 22px !important;
    border-radius: 1px !important;
}

.scheduler-left .ngb-dp-header {
    margin-bottom: -22px !important;
    height: 52px !important;
}

.scheduler-left ngb-datepicker-navigation .btn-link {
    padding: 0 2px;
    font-size: 13px;
    line-height: normal;
    border: none;
}

.scheduler-left .custom-select {
    padding: 2px 6px ;
    font-size: 13px ;
    border-radius: 2px ;
}

.scheduler-left .custom-select + .custom-select {
    margin-left: 2px;
    width: calc(50% - 2px);    
}

.scheduler-left ngb-datepicker-navigation-select {
    width: 124px;
}


.scheduler-left ngb-datepicker-navigation .ngb-dp-arrow{
    padding-right: 8px;
    padding-left: 8px;
    height: 24px;
}


ngb-datepicker-navigation {
    height: 24px !important;
    line-height: 22px !important;
}

ngb-datepicker-navigation .custom-select {
    padding: 2px 6px !important;
    font-size: 13px !important;
    border-radius: 2px !important;
    width: auto;
    height: 1.5rem !important;
}

.scheduler-left .btn-today {
    font-size: 11px;
    padding: 0;
    text-decoration: none;
}

.dropdown-menu.dropdown-sub-menu {
    top: 0;
    left: 100%;
}

.dropdown.submenu:hover > .dropdown-menu {
    display: block;
}

.custom-select-label {
    font-weight: 400;
    font-size: 12px;
    margin-bottom: 0;
}

.custom-select-box {
    background-color: #fcfcfc;
    font-size: 12px;
    padding: 0px;
    border-radius: 3px;
    border: 1px solid #c1d9ed;
    flex-grow:1;
    overflow:auto;
}
.custom-select-box .select-box-header{
    font-weight: 500;
    font-size: 14px;
    color: #2e7fc1;
    border-bottom: 1px solid #c1d9ed;        
    margin: 0;    
    padding: 4px 8px;

}

.custom-select-box .table {
    border: none;
    margin: 0;
}

.group-box{
    background-color: #fcfcfc;
    font-size: 12px;
    padding: 0px;
    border-radius: 3px;
    border: 1px solid #c1d9ed;
    flex-grow:1;
    overflow:auto;
}
.group-box .group-header{
    font-weight: 500;
    font-size: 14px;
    color: #2e7fc1;
    border-bottom: 1px solid #c1d9ed;        
    margin: 0;    
    padding: 4px 8px;

}
.group-box .table {
    border: none;
    margin: 0;
}

.custom-select-box .table-hover tbody tr:hover {
    background-color: rgb(209, 220, 230) !;
}

.custom-select-box .table tr.active,
.custom-select-box .table tr:hover.active {
    background-color: rgba(46, 189, 107, .6);
}

.modal.main-modal, .modal.main-modal .modal-content {
    border: none;
}

.modal-header.custom {
    background-color: #0376BB;
    color: #fff;
    height: 36px;
    padding: 8px 10px;
}

.modal-header.custom .logo {
    height: 18px;
    filter: brightness(100);
}

.modal-header.custom .modal-title {
    font-size: 14px;
    line-height: normal;
    font-weight: 400;    
    margin-left: 8px;
}

.modal-header.custom .close {
    color: #fff;
    text-shadow: none;
    opacity: .8;
    transition: 0.5s;
    padding: 0.8rem;
}

.modal-header.custom .close:hover {
    opacity: 1;
}

.modal-footer.custom {
    height: 35px;
    padding: 5px 10px;
    background-color:#dcecf7; /*#edeff5*/;
    border-radius: 0 0 4px 4px;
    /*border: none;*/
    border-top: 1px solid #c4dbed;
}

.modal-footer.custom>:not(:last-child) {
    margin-right: 2px;
}

.modal-footer.custom>:not(:first-child) {
    margin-left: 2px;
}

.modal-footer.custom .btn {
    font-size: 14px;
    line-height: 14px;
    padding: 4px 10px;
    border-radius: 3px;
}

.modal-footer.custom .btn-sm {
    font-size: 12px;    
}

.modal-body.custom {
    padding: 8px;
}

.modal-content {
    border: none;
}

.btn-group.radio-btn-tabs .btn {
    color: #656565;
    font-size: 14px;
    background-color: rgba(213,229,243,1);
    border: none;
    padding: 4px 10px;
}

.btn-group.radio-btn-tabs .btn-sm {
    font-size: 12px;
}

.btn-group.radio-btn-tabs .btn.active {
    background-color: #2e7fc1;
}

.btn-group.radio-btn-tabs .btn input[type="radio"], 
.btn-group.radio-btn-tabs .btn input[type="checkbox"] {
    display: none;
}
.encounter-module-scrollable{
    height: 200px !important;
    overflow: auto;
}
.alert-custom {    
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}
.alert-custom .logo {    
    height: 24px;    
    margin-top: -4px;
    padding-right: 8px;
}

.no-border{
    border:none !important;
}

/*CHART MODULE HEADDING*/
.chart-module-headding{
    background-color: #5fa7e2 !important;
}
.chart-module-headding-text{
    color:#ffffff !important;
}

/******** NDB Time Picker *******/
.form-control-ngb-timepicker{
    padding: 0px !important;    
    height: 24px !important;
    
} 

.table-td-ngb-timepicker{
    padding: 0px !important;    
    height: 21px !important;
    min-height:  21px !important;
    padding: 1px 0px !important;
} 

.form-control-ngb-timepicker .ngb-tp-input-container,
.table-td-ngb-timepicker .ngb-tp-input-container {
    width: 3em !important;
    padding: 1px 4px !important;;
}



.table-td-ngb-timepicker .ngb-tp-hour > .form-control, 
.table-td-ngb-timepicker .ngb-tp-minute > .form-control, 
.table-td-ngb-timepicker .ngb-tp-second > .form-control  {
    border-color: #80bdff;
    background-color:transparent;
    font-size: 12px;
    line-height: normal;
    padding: 0px;
    height: auto;
    resize: none;
    border: none;
    margin: 0px;
    border-radius:unset;
    min-height: unset;
}

.form-control-ngb-timepicker .ngb-tp-hour > .form-control, 
.form-control-ngb-timepicker .ngb-tp-minute > .form-control, 
.form-control-ngb-timepicker .ngb-tp-second > .form-control {
    border-color: #80bdff;
    background-color:transparent;
    font-size: 12px;
    line-height: normal;
    padding: 0px;
    min-height: 20px;
    height: auto;
    resize: none;
    border: none;
    margin: 0px;
    border-radius:unset;
    
 
}

.form-control-ngb-timepicker .ngb-tp-hour > .form-control:focus,
.form-control-ngb-timepicker .ngb-tp-minute > .form-control:focus, 
.form-control-ngb-timepicker .ngb-tp-second > .form-control:focus,
.table-td-ngb-timepicker .ngb-tp-hour > .form-control:focus, 
.table-td-ngb-timepicker .ngb-tp-minute > .form-control:focus, 
.table-td-ngb-timepicker .ngb-tp-second > .form-control:focus {           
    border: 1px solid #80bdff;
    outline: 0; 
    box-shadow: none;
}
   
.form-control-ngb-timepicker .ngb-tp-meridian > .btn,
.table-td-ngb-timepicker .ngb-tp-meridian > .btn  {    
    font-size: 12px;
    line-height: normal;
    padding: 0px 5px;
    min-height: 20px;
    border-radius: 3px;
    height: auto;
    resize: none;    
    color: #0073A9;
    background-color: transparent;
    border: none;
    border-radius: unset;
}  

.form-control-ngb-timepicker .ngb-tp-meridian > .btn{        
    min-height: 20px;    
}  

.table-td-ngb-timepicker .ngb-tp-meridian > .btn  {   
    min-height: unset;
}  


.form-control-ngb-timepicker .ngb-tp-meridian > .btn:focus, 
.form-control-ngb-timepicker .ngb-tp-meridian > .btn:active:focus, 
.form-control-ngb-timepicker .ngb-tp-meridian > .btn.active:focus,
.table-td-ngb-timepicker .ngb-tp-meridian > .btn:focus, 
.table-td-ngb-timepicker .ngb-tp-meridian > .btn:active:focus, 
.table-td-ngb-timepicker .ngb-tp-meridian > .btn.active:focus {
    
    border: 1px solid #80bdff;
    outline: 0; 
    box-shadow: none;
}


.form-control-ngb-timepicker .ngb-tp-spacer,
.table-td-ngb-timepicker .ngb-tp-spacer{
    font-weight: bold;
    width: 0.5em !important;
}


.ngb-timepicker-input-group-text{
    color:#0073aa;
    background-color: #e9f4f8;   
    font-size: 14px !important; 
}

  
