[data-title] {
    outline: red dotted 1px; /*optional styling*/
    font-size: 30px; /*optional styling*/
    
    position: relative;
    cursor: help;
  }
  
  [data-title]:hover::before {
    content: attr(data-title);
    position: absolute;
    bottom: 13px;
    display: inline-block;
    padding: 3px 6px;
    border-radius: 2px;
    background: #fff;
    color: #000;
    font-size: 13px;
    font-family: sans-serif;
    white-space: nowrap;
    left: 55px;
    z-index: 1;
    font-weight: 600;
  }
  [data-title]:hover::after {
    content: '';
    position: absolute;
    bottom: 18px;
    left: 39px;
    display: inline-block;
    color: #fff;
    border: 8px solid transparent;
    border-bottom: 8px solid #fff;
    rotate: -90deg;
  }
  li.nav-item [data-title] {
    outline: none;
    cursor: pointer;
}
