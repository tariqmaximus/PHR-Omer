.tab-content>.active {
    display: flex;
    flex-grow: 1;
}

.inner-sub-horizental-tab.content-flex .tab-content>.active {
    flex-direction: column;
}

.encounter-detail-top-bar {
    /* background-color: #2ebd6b; */
    background-color:#1960A3;
    height: 28px;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    font-size: 13px;
    overflow: hidden;
}

.left-back-btn {
    display: flex;
    background-color: #2f80c2;
    border: none;
    font-size: 13px;
    color: #ffffff;
    font-weight: 300;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    border-top-left-radius: 4px;
    cursor: pointer;
    transition: 0.5s;
}

.left-back-btn:hover {
    background-color: #206faf;
}

.top-right-blue-btn {
    display: flex;
    background-color: #2f80c2;
    border: none;
    font-size: 13px;
    color: #ffffff;
    font-weight: 300;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    border-top-right-radius: 4px;
    cursor: pointer;
    transition: 0.5s;
}

.top-right-blue-btn:hover {
    background-color: #206faf;
}

.nav.white-text,
.nav.white-text .nav-link {
    font-size: 13px;
    font-weight: 300;
    color: #ffffff;
    height: 28px;
}

.nav.white-text .nav-link {
    display: flex;
    align-items: center;
    border-left: 1px solid rgba(255, 255, 255, 0.25); 
    transition: 0.5s;
    cursor: pointer;
}

.nav.white-text .nav-link:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

.nav.color-buttons,
.nav.color-buttons .nav-link {
    font-size: 13px;
    font-weight: 300;
    color: #ffffff;
    height: 26px;
}

.nav.color-buttons .nav-btn {
    font-size: 12px;   
    color: #ffffff;
    height: 26px;
}

.nav.color-buttons .nav-link {
    display: flex;
    align-items: center;
    border: none;
    border-left: 1px solid rgba(255, 255, 255, 0.45); 
    transition: 0.5s;
    position: relative;
}

.nav.color-buttons .nav-link.green {    
    background-color: #1960A3;
}

.nav.color-buttons .nav-link.blue {    
    background-color: #0073aa;
}
.nav.color-buttons .nav-link.cancel {    
    background-color: #dc3545;
}

.nav.color-buttons .nav-link:hover {
    transition: 0.5s;
}

.nav.color-buttons .nav-link:hover::after {
    content: "";
    background-color: rgba(255, 255, 255, 0.1);
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
} 

.border-content-box {
    border: 1px solid #c5d7e3;
    background: #ffffff;
}

.border-content-box.light-sky-blue {
    background: #f9fcfe;
}

.green-gray-tabs .nav {
    height: 26px;
    border-radius: 4px 4px 0 0;
    overflow: hidden;
}

.green-gray-tabs .nav .nav-item {
    flex-grow: 1;
    display: flex;
}

.green-gray-tabs .nav .nav-item .nav-link {
    font-size: 14px;
    color: #454545;
    padding: 0;
    display: flex;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: #c0d9ed;
    border-right: 1px solid #e2edf7;
    cursor: pointer;
}
.green-gray-tabs .nav .nav-item:last-child .nav-link {
    border-right: none;
    
}

.green-gray-tabs .nav .nav-item .nav-link.active {
    color: #ffffff;
    background-color:#1960A3;
     
}

.light-blue-title-bar {
    background-color: #1960A3;
    height: 26px;
    overflow: hidden;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.light-blue-title-bar .title {
    font-size: 14px;
    color: #0e395c;
    font-weight: 500;
    margin: 0;
    text-shadow: 0px 2px 0px rgba(255, 255, 255, 0.5);
}

.info-box-stipes {
    background: #ffffff;
    border: 1px solid #c5d7e3;
    display: flex;
    flex-direction: column;
}

.info-box-stipes > .title-bar {
    /* Permalink - use to edit and share this gradient: http://colorzilla.com/gradient-editor/#000000+0,000000+100&0.03+0,0+100 */
    background: -moz-linear-gradient(top, rgba(0,0,0,0.03) 0%, rgba(0,0,0,0) 100%); /* FF3.6-15 */
    background: -webkit-linear-gradient(top, rgba(0,0,0,0.03) 0%,rgba(0,0,0,0) 100%); /* Chrome10-25,Safari5.1-6 */
    background: linear-gradient(to bottom, rgba(0,0,0,0.03) 0%,rgba(0,0,0,0) 100%); /* W3C, IE10+, FF16+, Chrome26+, Opera12+, Safari7+ */
    filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#08000000', endColorstr='#00000000',GradientType=0 ); /* IE6-9 */
    height: 25px;
    font-size: 14px;
    color: #252e47;
    font-weight: 500;
    padding-left: 10px;
    flex-shrink: 0;
    display: flex;
    line-height: normal;
    align-items: center;
}

.row.stipes {
    margin-right: 0;
    margin-left: 0;
}

.row.stipes > [class^="col-"] {
    padding-right: 0;
    padding-left: 0;
}

.stipe-content-view {
    height: 25px;
    display: flex;
    background-color: #f1f2f6;
    font-size: 12px;
    display: flex;
    align-items: center;
}

.stipe-content-view.tranparent {
    background: none;
}

.stipe-content-view .title {
    color: #2f80c2;
    font-weight: 400;
    padding-left: 8px;
}

.stipe-content-view .value {
    color: #252525;
    font-weight: 300;
    padding-left: 8px;
}

.pages-right-nav > .tab-content {
    border: 1px solid #c5d7e3;
    border-radius: .25rem 0 0 .25rem;
    flex-grow: 1;
}
/* 12-05-2018*/

.p-6 {
    padding: 6px !important;
}

.px6-py3 {
    padding: 3px 6px !important;
}

.filter-tab {
    background-color: rgb(218, 234, 251);
    height: 28px;
    padding: 0 8px;
    font-size: 13px;
    display: flex;
    flex-direction: row;
    align-content: center;
}

.form-row.p4 {
    margin-right: -4px;
    margin-left: -4px;
}

.form-row.p2 > [class^="col-"] {
    padding-right: 4px;
    padding-left: 4px;
}

.form-check-cont {
    font-size: 13px;
}

.info-box-stipes > .title-bar .form-check-inline {
    font-size: 12px;
    font-weight: 400;
}

.table.sm thead tr,
.table.sm tbody tr {
    height: 22px;
}

.table.sm th {
    font-weight: 500;
}

.table.sm td,
.table.sm th {
    padding: 2px 8px;
}

.fz-12 {
    font-size: 12px !important;
}

.fz-13 {
    font-size: 13px !important;
}

.fz-14 {
    font-size: 14px !important;
}

hr.m8 {
    margin-top: 8px;
    margin-bottom: 8px;
}

.table.sm.light-blue-striped-border tbody tr:nth-of-type(odd) {
    background-color: rgba(235,242,249,0.4);
}

.table.sm.light-blue-striped-border tbody tr:nth-of-type(even) {
    background-color: rgba(255,255,255,1.0);
}

.tree-view-bar {
    font-size: 12px;
    height: 25px;
    background-color: #f3f7fb;
    border-radius: .25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-right: 8px;
    padding-left: 28px;
    position: relative;
    border: 1px solid #eaedf0;
    cursor: pointer;
}

[aria-expanded="true"].tree-view-bar {
    border-radius: .25rem .25rem 0 0;
}

[aria-expanded="true"].tree-view-bar::after {
    font-family: 'Font Awesome 5 Free';
    font-size: 13px;
    color: #2e7fc1;
    content: "\f07c";
    position: absolute;
    left: 8px;
    top: 50%;
    transform: translateY(-50%);
}

[aria-expanded="false"].tree-view-bar::after {
    font-family: 'Font Awesome 5 Free';
    font-size: 13px;
    color: #2e7fc1;
    content: "\f07b";
    position: absolute;
    left: 8px;
    top: 50%;
    transform: translateY(-50%);
}

.tree-view-content {
    background-color: #fcfdfe;
    border: 1px solid #eaedf0;
    border-top: none;
}

.tree-view + .tree-view {
    margin-top: 2px;
}

.inner-sub-horizental-tab > .nav {
    background-color: #80b7e4;
    height: 28px;
    line-height: normal;
    padding-left: 10px;
    flex-shrink: 0;
    border: none;
}
.inner-sub-horizental-tab.tab-h30 > .nav {
    height: 30px;
}

.inner-sub-horizental-tab > .nav .nav-link {
    font-size: 13px;
    color: #ffffff;
    padding: 0 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: 0.5s;
    font-weight: 300;
    border: none;
    border-radius: 0;
    height: 100%;
    background: none;
}

.inner-sub-horizental-tab > .nav .nav-link.active {
    color: #252525;
    font-weight: 400;
}

.inner-sub-horizental-tab > .nav .nav-link.active span {
    z-index: 100;
    padding-top: 5px;
}

.inner-sub-horizental-tab > .nav .nav-link.active::after {
    content: "";
    position: absolute;
    top: 6px;
    right: 0;
    bottom: 0;
    left: 0;
    width: auto;
    background-color: #edf3fa;
    border-radius: 4px 4px 0 0;
}

.border-content-box.light-gray-bg, .light-gray-bg {
    background-color: #f9fcfe !important;
}

