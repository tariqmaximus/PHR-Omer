/********************* Main Left Nav *********************/
.content-wrapper .navbar.left-nav {
    flex-direction: row;
    flex-grow: 1;
    align-items: stretch;
    padding: 0;
    flex-wrap: nowrap;
    height: calc(100% - 40px);
}

.navbar.left-nav > .nav-tabs {
    width: 50px;
    background-color: #2283C6;
    flex-shrink: 1;
    display: flex;
    flex-direction: column;
    border: none;
}

.navbar.left-nav > .tab-content {
    display: flex;
    flex: 1 1 auto;
    width: calc(100% - 50px);
}

.navbar.left-nav > .tab-content > .tab-pane {
    flex-grow: 1;
}

.navbar.left-nav > .tab-content > .active {
    display: flex;
    width: 100%;
}

.navbar.left-nav > .nav-tabs > .nav-item > .nav-link {
    color: rgba(255, 255, 255, 0.92);
    padding: 0;
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    border-radius: 0;
    height: 50px;
    width: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: 0.5s;
}

.navbar.left-nav > .nav-tabs > .nav-item > .nav-link:hover {
    background-color: rgba(0,0,0,.1);
    color: rgba(255, 255, 255, 1);
    text-decoration: none;
}

.navbar.left-nav > .nav-tabs > .nav-item > .nav-link i {
    font-size: 24px;
}

.navbar.left-nav > .nav-tabs > .nav-item > .nav-link.active {
    background-color: #1960A3;
    color: rgba(255, 255, 255, 1);
}

/********************* Main Top Nav *********************/
.navbar-top-main {
    background-color: rgb(241 244 255 / 85%);
    box-shadow: none;
    height: 30px;
    line-height: 30px;
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    border-bottom: 1px solid #e9e9e9;
}

.navbar-top-main h1 {
    font-family: 'Roboto';
    font-weight: 600;
    font-size: 12px;
    color: #1960A3;
    margin: 0 0 0 20px;
}

.navbar-top-main .navbar-collapse {
    justify-content: flex-end;
}

.navbar-top-main .nav-item > a {
    color: #656565;
    padding: 0 10px;
    border-left: 1px solid rgba(0,0,0,0.05);
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
}

.navbar-top-main .nav-item > a i {
    font-size: 24px;
}

.navbar-top-main .nav-item > a:hover {
    background-color: rgba(0,0,0,0);
    color: #656565;
    text-decoration: none;
}

.navbar-top-main .nav-item.active {
    background: #ffffff; /* Old browsers */
    background: -moz-linear-gradient(top, #ffffff 0%, #f5f6fa 100%); /* FF3.6-15 */
    background: -webkit-linear-gradient(top, #ffffff 0%,#f5f6fa 100%); /* Chrome10-25,Safari5.1-6 */
    background: linear-gradient(to bottom, #ffffff 0%,#f5f6fa 100%); /* W3C, IE10+, FF16+, Chrome26+, Opera12+, Safari7+ */
    filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#ffffff', endColorstr='#f5f6fa',GradientType=0 ); /* IE6-9 */
}

.navbar-top-main .nav-item.active > a {
    color: #2e7fc1;
}

.navbar-top-main .nav-item.active > a:hover {
    background-color: rgba(0,0,0,0);
}

.user-profile-btn {
    font-family: 'Roboto';
    font-weight: 300;
    font-size: 13px;
    display: flex;
    align-items: center;
}

.user-profile-btn .pic {
    width: 24px;
    height: 24px;
    margin-right: 5px;
    border-radius: 50%;
}

.navbar-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 30px;
    background-color: rgba(237, 239, 245,0.9);
    margin: 0;
    padding: 0;
}

.navbar-brand img {
    height: 24px;
    width: auto;
}

.dropdown-menu.user-profile {
    background-color: #ffffff;
    margin: 0;
    border-radius: 0 0 3px 3px;
    border: none;
}

.dropdown-menu.user-profile .dropdown-item {
    font-size: 13px;
    font-weight: 300;
    color: #656565;
    line-height: normal;
    padding: 5px 15px;
}

.dropdown-menu.user-profile .dropdown-item .fa {
    margin-right: 8px;
}

.dropdown-menu.user-profile .dropdown-item:hover,
.dropdown-menu.user-profile .dropdown-item.active,
.dropdown-menu.user-profile .dropdown-item:active {
    color: #252525;
    text-decoration: none;
    background-color: rgba(0, 0, 0, 0.015);
}


/********************* Patient Top Main Nav *********************/
.nav.sub-nav {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    align-items: stretch;
    height: 100%;
    flex-wrap: nowrap;
}

.nav.sub-nav > .nav-tabs {
    border: none;
    background-color: rgba(255, 255, 255, 0.45);
    box-shadow: none;
    /*box-shadow: 0px 2px 10px #aaaaaa;*/
    height: 30px;
    line-height: 30px;
    flex-shrink: 0;
    padding: 0 8px;
    margin: 0;
    border-top: 1px solid #eceef5;
}

.nav.sub-nav > .nav-tabs > .nav-item {
    margin-bottom: 0;
    color: #8792af;
    padding: 0;
    font-size: 13px;
    margin: 0 8px;
    background: none;
    border: none;
    cursor: pointer;
}

.nav.sub-nav > .nav-tabs > .nav-item > button {
    background: none;
    border: none;
    padding: 0px;
    cursor: pointer;
}

.nav.sub-nav > .nav-tabs > .nav-item > .tab-close {
    background: none;
    border: none;
    color: #8792af;
    margin-left: 8px;
}

.nav.sub-nav > .nav-tabs > .nav-item > .tab-close:hover {
    color: #ce4b27;
}

.nav.sub-nav > .nav-tabs > .nav-item:hover {
    color: #2e7fc1;
}

.nav.sub-nav > .nav-tabs > .nav-item.active {
    color: #495474;
    position: relative;
}

.nav.sub-nav > .nav-tabs > .nav-item.active::after {
    content: "";
    position: absolute;
    right: 0;
    left: 0;
    bottom: 0;
    background-color: #2ebd6b;
    height: 2px;
}

.nav.sub-nav > .patient-search {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.nav.sub-nav > .tab-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 8px;
    overflow: hidden;
}

.nav.sub-nav > .tab-content > my-tab {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.nav.sub-nav >  .tab-content > my-tab > .search-patient-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.nav.sub-nav > .tab-content > #find-patient-panel.active {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.nav.sub-nav > .tab-content > my-tab > patient-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}


/********************* Patient Summary Nav *********************/
.nav.pateint-nav {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    flex-grow: 1;
}

.nav.pateint-nav > .nav-tabs {
    background-color: #0073aa;
    height: 24px;
    line-height: 24px;
    border: none;
    flex-shrink: 0;
}

.nav.pateint-nav > .nav-tabs > .nav-item > .nav-link {
    font-size: 13px;
    color: #454545;
    padding: 0 10px;
    background-color: rgba(255,255,255,0.7);
    margin-right: 2px;
    transition: 0.5s;
    border-radius: 1px 1px 0 0;
    border: none;
}

.nav.pateint-nav > .nav-tabs > .nav-item > .nav-link:hover {
    background-color: rgba(255,255,255,0.9);
}

.nav.pateint-nav > .nav-tabs > .nav-item > .nav-link.active {
    color: #ffffff;
    background-color: #2ebd6b;
}

.nav.pateint-nav > .tab-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.nav.pateint-nav > .tab-content > .active {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.nav.pateint-nav > .tab-content > .tab-pane > .patient-all-comp{
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}
.inner-horizental-blue-tab {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    align-items: stretch;
    height: 100%;
    flex-wrap: nowrap;
}

.inner-horizental-blue-tab > .nav {
    background-color: #2e7fc1;
    height: 30px;
    line-height: normal;
    flex-shrink: 0;
    border: none;
}

.inner-horizental-blue-tab > .nav .nav-item {
    margin: 0;
}

.inner-horizental-blue-tab > .nav .nav-link {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.9);
    padding: 0 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: 0.5s;
    font-weight: 300;
    border: none;
    border-radius: 0;
    height: 100%;
}
.inner-horizental-blue-tab > .nav .nav-link::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 1px;
    background-color: rgba(255, 255, 255, 0.2);
}
.inner-horizental-blue-tab > .nav .nav-link:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

.inner-horizental-blue-tab > .nav .nav-link.active {
    color: rgba(255, 255, 255, 1);
    background-color: #2ebd6b;
    font-weight: 300;
}

.inner-horizental-blue-tab > .tab-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.inner-horizental-blue-tab > .tab-content .tab-pane.active {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.inner-horizental-green-tab {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    align-items: stretch;
    height: 100%;
    flex-wrap: nowrap;
}

.inner-horizental-green-tab > .nav {
    background-color: #b3d5e6;
    height: 30px;
    line-height: normal;
    padding-left: 10px;
    flex-shrink: 0;
    border: none;
}

.inner-horizental-green-tab > .tab-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.inner-horizental-green-tab > .nav .nav-link {
    font-size: 13px;
    color: #454545;
    padding: 0 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: 0.5s;
    font-weight: 300;
    border: none;
    border-radius: 0;
    height: 100%;
    background: none;
}
.inner-horizental-green-tab > .nav .nav-link::after {
    content: "";
    position: absolute;
    top: 6px;
    right: 0;
    bottom: 6px;
    width: 1px;
    background-color: rgba(255, 255, 255, 0.3);
}

.inner-horizental-green-tab > .nav .nav-link.active {
    color: #454545;
    font-weight: 300;
}

.inner-horizental-green-tab > .nav .nav-link.active span {
    z-index: 100;
    padding-top: 5px;
}

.inner-horizental-green-tab > .nav .nav-link.active::after {
    content: "";
    position: absolute;
    top: 6px;
    right: 0;
    bottom: 0;
    left: 0;
    width: auto;
    background-color: #edf3fa;
    border-radius: 4px 4px 0 0;
}

.inner-vertical-tab {
    flex-direction: column;
    flex-grow: 1;
}

.inner-vertical-tab > .nav {
    flex-direction: column;
    flex-shrink: 0;
    height: auto;
    width: 150px;
}

.inner-vertical-tab.white > .nav {
    background-color: rgba(255, 255, 255, 0.9);
}

.inner-vertical-tab.light-gray > .nav {
    background-color: rgba(208, 218, 226, 1);
}

.inner-vertical-tab > .nav .nav-link {
    font-size: 13px;
    color: #454545;
    padding: 0 10px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    position: relative;
    transition: 0.5s;
    font-weight: 300;
    height: 28px;
    border: none;
    border-radius: 0;
    background: none;
}
.inner-vertical-tab > .nav .nav-link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 1px;
    background-color: rgba(237, 239, 245, 0.9);
}
.inner-vertical-tab.light-gray > .nav .nav-link::after {
    background-color: rgba(237, 239, 245, 0.6);
}

.inner-vertical-tab.light-gray > .nav .nav-link {
    color: #353535;
}

.inner-vertical-tab > .nav .nav-link.active {
    color: #252525;
    font-weight: 300;
    background: #edeff5;
}

.inner-vertical-tab > .tab-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    width: 100px;
}
