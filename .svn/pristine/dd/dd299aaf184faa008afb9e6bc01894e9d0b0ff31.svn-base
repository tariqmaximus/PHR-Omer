    border-top-right-radius: .25rem!important;
    border-bottom-right-radius: 0!important;
    border-bottom-left-radius: 0!important;
    border-top-left-radius: 0!important;
}

.custom-control-label {
    font-size: 13px;
    font-weight: 400;
    line-height: normal;
    vertical-align: baseline;
}

.custom-control-label::before,
.custom-control-label::after {
    top: 0rem;
    left: -1.35rem;
}
.table .custom-control-label::before,
.table .custom-control-label::after {
    top: .175rem;
    left: -1.35rem;
}
.table thead .custom-control-label::before,
.table thead .custom-control-label::after {
    top: .125rem;
    left: -1.35rem;
}
.custom-checkbox.no-label .custom-control-label::before,
.custom-checkbox.no-label .custom-control-label::after,
.custom-radio.no-label .custom-control-label::before,
.custom-radio.no-label .custom-control-label::after {
    left: 0;
}
.table thead .custom-control-label::before {
    background-color: #fff;
}
.custom-checkbox,
.custom-radio {
    margin-left: 22px;
}
.custom-checkbox.no-label,
.custom-radio.no-label {
    margin-left: 0px;
}
.custom-checkbox.green-checkbox .custom-control-input:checked~.custom-control-label::before,
.custom-radio.green-radio .custom-control-input:checked~.custom-control-label::before {
    background-color: #2ebd6b;
}
.custom-checkbox.blue-checkbox .custom-control-input:checked~.custom-control-label::before,
.custom-radio.blue-radio .custom-control-input:checked~.custom-control-label::before {
    background-color: #2e7fc1;
}
.custom-control-input:focus~.custom-control-label::before {
    box-shadow: none;
}

.custom-checkbox + .custom-checkbox,
.custom-radio + .custom-radio,
.custom-checkbox + .custom-radio,
.custom-radio + .custom-checkbox {
    padding-left: 10px;
}

