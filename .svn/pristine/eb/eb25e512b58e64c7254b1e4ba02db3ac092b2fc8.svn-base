
<div class="modal-header dialog px-3 py-2 alert" style="height: 40px" role="alert" 
[ngClass]="{
  'alert-primary' : (alertType === 'primary'),
  'alert-info' : (alertType === 'info'),
  'alert-warning' : (alertType === 'warning'),
  'alert-danger' : (alertType === 'danger')}">

  <h1 class="fz-16"><img alt="Maximus" class="mr-2" src="./assets/images/logo-small.png">{{promptHeading}}</h1>
</div>
  <div class="dialog mb-2" style="height: 50px;padding-left: 15px;">
    <div class="d-flex align-items-center">
      

      <i class="fa fa-2x mr-3"
      [ngClass]="{
        'text-primary' : (alertType === 'primary'),
        'fas fa-check-circle text-success' : (alertType === 'info'),
        'fas fa-exclamation-triangle alert-warning-text' : (alertType === 'warning'),
        'fas fa-times-circle text-danger' : (alertType === 'danger')}"></i>
        <div class="col col-10 pl-0" [innerHTML]="promptMessage">

      </div>
    </div>
  </div>
<div class="modal-footer custom">
  <button type="button" style="width: 80px;" class="btn btn-primary btn-sm" (click)="yesClick()">Yes</button>
  <button type="button" style="width: 80px;" class="btn btn-dark btn-sm" (click)="noClick()">No</button>
</div>